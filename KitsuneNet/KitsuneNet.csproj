<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CodeAnalysisRuleSet>..\analysis.ruleset</CodeAnalysisRuleSet>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>KitsuneNet</PackageId>
    <Version>1.0.0</Version>
    <Authors>TerrahKitsune</Authors>
    <Description>Managed .NET bindings for the Kitsune Lua scripting engine. Requires the native KitsuneEngine library (win-x64 and linux-x64 included).</Description>
    <PackageTags>lua;scripting;kitsune;coroutine</PackageTags>
    <RepositoryUrl>https://github.com/TerrahKitsune/Lua-Kitsune</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Add <PackageReadmeFile>README.md</PackageReadmeFile> once a README.md exists at the repo root -->
    <!-- Suppress NuGet warnings for missing optional pack metadata -->
    <NoWarn>$(NoWarn);NU5125</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <NativeVcxProj>$(ProjectDir)..\KitsuneEngine.vcxproj</NativeVcxProj>
    <NativeOutputDir>$(ProjectDir)..\x64\$(Configuration)\</NativeOutputDir>
    <NativeRootDir>$(ProjectDir)..\</NativeRootDir>
    <!-- WSL /mnt/X/... equivalent of the repo root.  Must use the always-absolute
         $(MSBuildProjectDirectory) because $(ProjectDir) is not yet set when global
         PropertyGroups are evaluated in SDK-style projects. -->
    <_NativeRootAbsFwd>$(MSBuildProjectDirectory.Replace('\', '/'))/..</_NativeRootAbsFwd>
    <_WslRepoPath>/mnt/$(_NativeRootAbsFwd.Substring(0, 1).ToLower())/$(_NativeRootAbsFwd.Substring(3).TrimEnd('/'))</_WslRepoPath>
  </PropertyGroup>

  <!-- Windows only: builds KitsuneEngine.vcxproj and copies the native DLLs.
       When building inside VS the solution dependency on KitsuneEngine already ensures
       the DLL is produced before this project runs, so the MSBuild invocation is skipped
       and we only copy. Outside VS (dotnet CLI) we must drive the C++ build ourselves
       and forward SolutionDir/SolutionPath so all $(SolutionDir)-based paths resolve. -->
  <Target Name="BuildNativeEngine" BeforeTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(BuildingInsideVisualStudio)' != 'true'">
    <MSBuild Projects="$(NativeVcxProj)"
             Properties="Configuration=$(Configuration);Platform=x64;SolutionDir=$(NativeRootDir);SolutionPath=$(NativeRootDir)Kitsune.sln" />
  </Target>

  <Target Name="CopyNativeDlls" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <_NativeDlls Include="$(NativeOutputDir)*.dll" Condition="Exists('$(NativeOutputDir)')" />
      <_NativeDlls Include="$(NativeRootDir)*.dll" Condition="Exists('$(NativeRootDir)')" />
      <!-- Bundled libcurl (WebSocket-enabled build stored in curl\lib\) -->
      <_NativeDlls Include="$(NativeRootDir)curl\lib\*.dll" Condition="Exists('$(NativeRootDir)curl\lib\')" />
      <_NativePdbs Include="$(NativeOutputDir)*.pdb" Condition="Exists('$(NativeOutputDir)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeDlls)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_NativePdbs)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Delete KitsuneEngine.so (no lib prefix) whenever it appears in the output directory.
       On Linux, .NET P/Invoke tries name.so before libname.so, so a stale bare-named file
       silently wins over the correct libKitsuneEngine.so. -->
  <Target Name="DeleteStaleSo" BeforeTargets="Build">
    <Delete Files="$(OutputPath)KitsuneEngine.so" Condition="Exists('$(OutputPath)KitsuneEngine.so')" />
  </Target>

  <!-- On Windows with WSL2: cmake-build libKitsuneEngine.so before copying it.
       Mirrors BuildNativeEngine above but for the Linux CMake build.
       The cmake build step is incremental so subsequent builds are fast; cmake configure
       is skipped when build-linux/CMakeCache.txt already exists.
       If wsl is not installed the target emits a warning and CopyLinuxNativeSo skips. -->
  <Target Name="BuildLinuxNative" BeforeTargets="CopyLinuxNativeSo"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="wsl bash -c &quot;set -e; mkdir -p '$(_WslRepoPath)/build-linux'; cd '$(_WslRepoPath)/build-linux'; if [ ! -f CMakeCache.txt ]; then cmake .. -DCMAKE_BUILD_TYPE=Release -DKITSUNE_ALL=ON; fi; cmake --build . --parallel&quot;"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <!-- Copy libKitsuneEngine.so whenever it exists (Linux build or Windows with pre-built .so).
       Unconditional so VS remote testing can include it when sending the output to WSL2. -->
  <Target Name="CopyLinuxNativeSo" BeforeTargets="Build"
          Condition="Exists('$(NativeRootDir)build-linux/libKitsuneEngine.so')">
    <Copy SourceFiles="$(NativeRootDir)build-linux/libKitsuneEngine.so"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Tell VS's fast up-to-date check that build-linux/libKitsuneEngine.so is a required
       output of this project on Windows.  When the file is absent the project is considered
       not up-to-date, so a full build is triggered and BuildLinuxNative runs. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <UpToDateCheckBuilt Include="$(MSBuildProjectDirectory)\..\build-linux\libKitsuneEngine.so" />
  </ItemGroup>

  <!-- ── NuGet native packaging ──────────────────────────────────────────────────────
       Native DLLs are placed under runtimes/{rid}/native/ inside the .nupkg so that the
       .NET SDK copies the correct binary to the consuming project's output directory.
       The build/KitsuneNet.targets file is included so consuming projects also get an
       explicit CopyToOutputDirectory item when the SDK's RID-based copy is not enough
       (e.g. framework-dependent builds without an explicit RuntimeIdentifier).       -->

  <!-- Windows x64 native DLL (built by KitsuneEngine.vcxproj) -->
  <ItemGroup Condition="Exists('$(NativeOutputDir)KitsuneEngine.dll')">
    <None Include="$(NativeOutputDir)KitsuneEngine.dll"
          Pack="true"
          PackagePath="runtimes/win-x64/native/KitsuneEngine.dll" />
  </ItemGroup>

  <!-- Linux x64 shared library (built by CMake / WSL) -->
  <ItemGroup Condition="Exists('$(NativeRootDir)build-linux/libKitsuneEngine.so')">
    <None Include="$(NativeRootDir)build-linux/libKitsuneEngine.so"
          Pack="true"
          PackagePath="runtimes/linux-x64/native/libKitsuneEngine.so" />
  </ItemGroup>

  <!-- MSBuild targets file that consumers automatically import.
       NuGet convention: build/{PackageId}.targets is auto-imported by the SDK. -->
  <ItemGroup>
    <None Include="build\KitsuneNet.targets"
          Pack="true"
          PackagePath="build/KitsuneNet.targets" />
  </ItemGroup>

</Project>
