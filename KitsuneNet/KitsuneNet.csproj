<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <NativeVcxProj>$(ProjectDir)..\Kitsune.vcxproj</NativeVcxProj>
    <NativeOutputDir>$(ProjectDir)..\x64\$(Configuration)\</NativeOutputDir>
    <NativeRootDir>$(ProjectDir)..\</NativeRootDir>
  </PropertyGroup>

  <!-- Windows only: builds Kitsune.vcxproj and copies the native DLLs. -->
  <Target Name="BuildNativeEngine" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <MSBuild Projects="$(NativeVcxProj)" Properties="Configuration=$(Configuration);Platform=x64" />
    <ItemGroup>
      <_NativeDlls Include="$(NativeOutputDir)*.dll" />
      <_NativeDlls Include="$(NativeRootDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeDlls)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy libKitsuneEngine.so whenever it exists (Linux build or Windows with pre-built .so).
       Unconditional so VS remote testing can include it when sending the output to WSL2. -->
  <Target Name="CopyLinuxNativeSo" BeforeTargets="Build"
          Condition="Exists('$(NativeRootDir)build-linux/libKitsuneEngine.so')">
    <Copy SourceFiles="$(NativeRootDir)build-linux/libKitsuneEngine.so"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
