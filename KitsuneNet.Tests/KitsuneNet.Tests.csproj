<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CodeAnalysisRuleSet>..\analysis.ruleset</CodeAnalysisRuleSet>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\kitsune.runsettings</RunSettingsFilePath>
    <!-- UseConfigureAwait is not applicable to xUnit tests: the framework provides no
         synchronisation context, so ConfigureAwait(false) is both unnecessary and noise. -->
    <NoWarn>$(NoWarn);UseConfigureAwait</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <NativeOutputDir>$(ProjectDir)..\x64\$(Configuration)\</NativeOutputDir>
    <NativeRootDir>$(ProjectDir)..\</NativeRootDir>
    <!-- WSL path to the repo root.  Uses the always-absolute $(MSBuildProjectDirectory)
         for the same reason as KitsuneNet.csproj. -->
    <_NativeRootAbsFwd>$(MSBuildProjectDirectory.Replace('\', '/'))/..</_NativeRootAbsFwd>
    <_WslRepoPath>/mnt/$(_NativeRootAbsFwd.Substring(0, 1).ToLower())/$(_NativeRootAbsFwd.Substring(3).TrimEnd('/'))</_WslRepoPath>
  </PropertyGroup>

  <!--
    Copies all native DLLs into the test output directory so the test runner
    can resolve KitsuneEngine.dll and its dependencies at runtime.
    KitsuneNet's BuildNativeEngine target ensures they are built first.
    Includes both x64\$(Configuration)\ and the repo root (hiredis, libmysql).
  -->
  <Target Name="CopyNativeDlls" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <_NativeDlls Include="$(NativeOutputDir)*.dll" Condition="Exists('$(NativeOutputDir)')" />
      <_NativeDlls Include="$(NativeRootDir)*.dll" Condition="Exists('$(NativeRootDir)')" />
      <_NativePdbs Include="$(NativeOutputDir)*.pdb" Condition="Exists('$(NativeOutputDir)')" />
      <!-- Bundled libcurl (WebSocket/SSL-enabled build stored in curl\lib\).
           Copied in a separate step AFTER the NativeOutputDir pass so that the
           newer wss-capable build overwrites any older libcurl from x64\$(Configuration)\. -->
      <_CurlDlls Include="$(NativeRootDir)curl\lib\*.dll" Condition="Exists('$(NativeRootDir)curl\lib\')" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeDlls)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_NativePdbs)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_CurlDlls)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" />
  </Target>

  <!-- Delete KitsuneEngine.so (no lib prefix) whenever it appears in the output directory.
       On Linux, .NET P/Invoke tries name.so before libname.so, so a stale bare-named file
       silently wins over the correct libKitsuneEngine.so. -->
  <Target Name="DeleteStaleSo" BeforeTargets="Build">
    <Delete Files="$(OutputPath)KitsuneEngine.so" Condition="Exists('$(OutputPath)KitsuneEngine.so')" />
  </Target>

  <!-- On Windows with WSL2: cmake-build libKitsuneEngine.so before copying it.
       Placed here (not only in KitsuneNet.csproj) because KitsuneNet is a ProjectReference
       that MSBuild may skip when C# files are up-to-date, whereas this Tests project is
       always the top-level build entry point for WSL remote-test runs.
       Document order before CopyNativeSo guarantees cmake completes first. -->
  <Target Name="BuildLinuxNative" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="wsl bash -c &quot;set -e; mkdir -p '$(_WslRepoPath)/build-linux'; cd '$(_WslRepoPath)/build-linux'; if [ ! -f CMakeCache.txt ]; then cmake .. -DCMAKE_BUILD_TYPE=Release -DKITSUNE_ALL=ON; fi; cmake --build . --parallel&quot;" ContinueOnError="WarnAndContinue" />
  </Target>

  <!-- Copy libKitsuneEngine.so whenever it exists (Linux build or Windows with pre-built .so).
       Inputs/Outputs let MSBuild re-run this target whenever build-linux produces a newer .so,
       even when the C# project itself is otherwise up-to-date. -->
  <Target Name="CopyNativeSo" BeforeTargets="Build" Condition="Exists('$(ProjectDir)../build-linux/libKitsuneEngine.so')" Inputs="$(ProjectDir)../build-linux/libKitsuneEngine.so" Outputs="$(OutputPath)libKitsuneEngine.so">
    <Copy SourceFiles="$(ProjectDir)../build-linux/libKitsuneEngine.so" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Tell VS's fast up-to-date check that libKitsuneEngine.so is a required output.
       When it is absent the project is not up-to-date, triggering CopyNativeSo. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <UpToDateCheckBuilt Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\net10.0\libKitsuneEngine.so" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Shouldly" Version="4.2.1" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KitsuneNet\KitsuneNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\test.7z">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>test.7z</Link>
    </Content>
    <Content Include="..\test.zip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>test.zip</Link>
    </Content>
  </ItemGroup>
  <!-- Copy SQLiteKitsune.dll whenever it is newer than the copy in the test output.
       Inputs/Outputs enable MSBuild incremental build; UpToDateCheckBuilt tells VS's fast
       up-to-date check to compare the native source against the output copy so a C++-only
       rebuild triggers a re-copy even when no C# files have changed. -->
  <Target Name="CopyNativeSqliteDll" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows')) and Exists('$(NativeOutputDir)SQLiteKitsune.dll')" Inputs="$(NativeOutputDir)SQLiteKitsune.dll" Outputs="$(OutputPath)SQLiteKitsune.dll">
    <Copy SourceFiles="$(NativeOutputDir)SQLiteKitsune.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <UpToDateCheckBuilt Include="$(OutputPath)SQLiteKitsune.dll" Original="$(NativeOutputDir)SQLiteKitsune.dll" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="bin\Release\net10.0\" />
  </ItemGroup>

</Project>
