<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CodeAnalysisRuleSet>..\analysis.ruleset</CodeAnalysisRuleSet>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\kitsune.runsettings</RunSettingsFilePath>
    <!-- UseConfigureAwait is not applicable to xUnit tests: the framework provides no
         synchronisation context, so ConfigureAwait(false) is both unnecessary and noise. -->
    <NoWarn>$(NoWarn);UseConfigureAwait</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <NativeOutputDir>$(ProjectDir)..\Lua-Kitsune\x64\$(Configuration)\</NativeOutputDir>
    <NativeRootDir>$(ProjectDir)..\Lua-Kitsune\</NativeRootDir>
  </PropertyGroup>

  <!--
    Copies all native DLLs into the test output directory so the test runner
    can resolve KitsuneEngine.dll and its dependencies at runtime.
    KitsuneNet's BuildNativeEngine target ensures they are built first.
    Includes both x64\$(Configuration)\ and the repo root (hiredis, libmysql).
  -->
  <Target Name="CopyNativeDlls" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <_NativeDlls Include="$(NativeOutputDir)*.dll" Condition="Exists('$(NativeOutputDir)')" />
      <_NativeDlls Include="$(NativeRootDir)*.dll" Condition="Exists('$(NativeRootDir)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeDlls)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy libKitsuneEngine.so whenever it exists (Linux build or Windows with pre-built .so).
       Unconditional so VS remote testing can include it when sending the output to WSL2. -->
  <Target Name="CopyNativeSo" BeforeTargets="Build"
          Condition="Exists('$(ProjectDir)../build-linux/libKitsuneEngine.so')">
    <Copy SourceFiles="$(ProjectDir)../build-linux/libKitsuneEngine.so"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Shouldly" Version="4.2.1" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KitsuneNet\KitsuneNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\test.7z">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>test.7z</Link>
    </Content>
    <Content Include="..\test.zip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>test.zip</Link>
    </Content>
  </ItemGroup>

</Project>
